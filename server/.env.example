# ---- Server ----
PORT=5000
NODE_ENV=development
# Public URL of the site (used in emails, WhatsApp document links, etc.)
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yjtechnosoft

# ---- First admin (created by `npm run db:seed`) ----
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yjtechnosoft.com
ADMIN_PASSWORD=Admin@123

# Email / SMS / WhatsApp credentials are managed from Admin > Settings > Integrations.
