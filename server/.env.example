# ---- Server ----
PORT=5000
NODE_ENV=development
# Public URL of the site (used in emails, WhatsApp document links, etc.)
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173

# Timezone for attendance, invoices and reminders
TZ=Asia/Kolkata

# ---- MySQL ----
# Either one URL:  DATABASE_URL=mysql://user:password@host:3306/dbname
# or the separate values below. Tables are created automatically on start.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yjtechnosoft
DB_TIMEZONE=+05:30

# ---- First admin (created by `npm run db:seed`) ----
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yjtechnosoft.com
ADMIN_PASSWORD=Admin@123

# Email / SMS / WhatsApp credentials are managed from Admin > Settings > Integrations.

# ---- Profile builder PDF engine ----
# Path to Chromium / Google Chrome. Leave empty to auto-detect; without it,
# profiles are saved as PDF from the browser's print dialog instead.
CHROME_PATH=

# ---- Locked out? ----
# Set ADMIN_RESET=1 and restart: the account ADMIN_EMAIL becomes an admin with
# ADMIN_PASSWORD (created if missing). Remove it again after logging in.
# Or run:  npm run reset-admin -- you@example.com NewPassword123
ADMIN_RESET=
