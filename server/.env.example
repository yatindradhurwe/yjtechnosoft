# ---- Server ----
PORT=5000
NODE_ENV=development
# Public URL of the site (used in emails, WhatsApp document links, etc.)
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d
# Employee mobile app (Flutter): access token lifetime and refresh token lifetime (days)
MOBILE_ACCESS_TTL=1h
MOBILE_REFRESH_DAYS=90
CORS_ORIGIN=http://localhost:5173

# Timezone for attendance, invoices and reminders
TZ=Asia/Kolkata

# ---- MySQL ----
# Either one URL:  DATABASE_URL=mysql://user:password@host:3306/dbname
# or the separate values below. Tables are created automatically on start.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yjtechnosoft
DB_TIMEZONE=+05:30

# ---- First admin (created by `npm run db:seed`) ----
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yjtechnosoft.com
ADMIN_PASSWORD=Admin@123

# Email / SMS / WhatsApp credentials are managed from Admin > Settings > Integrations.
