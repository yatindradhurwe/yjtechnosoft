{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yjtechnosoft.com/poster-engine/template.schema.json",
  "title": "Poster Engine Template / Frame",
  "description": "A creative template (or a reusable brand frame). Layers are painted in array order: the first layer is the bottom of the stack.",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "canvas", "layers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["template", "frame"] },
    "id": { "$ref": "#/$defs/slug" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "name": { "type": "string", "maxLength": 200 },
    "canvas": {
      "type": "object",
      "description": "Design size in px. Every box is in this coordinate space. Output can be scaled.",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "background": { "$ref": "#/$defs/color" }
      }
    },
    "meta": {
      "type": "object",
      "description": "Catalog metadata used for filtering and search. Ignored by the renderer.",
      "additionalProperties": false,
      "properties": {
        "aspectRatio": { "enum": ["1:1", "4:5", "9:16", "16:9", "1.91:1", "3:4", "2:3", "A4"] },
        "languages": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" } },
        "contentStyle": { "enum": ["promotional", "educational", "emotional", "lead_generation", "showcase", "greeting"] },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "festivalKeys": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 50 } },
        "slot": { "enum": ["footer", "header", "full", "side"], "description": "Frames only: which frame slot this frame fills." },
        "premium": { "type": "boolean" }
      }
    },
    "fonts": {
      "type": "array",
      "description": "Font families the template needs. The render worker must have them installed or registered.",
      "items": { "type": "string" }
    },
    "layers": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/layer" }
    }
  },

  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
    "binding": {
      "type": "string",
      "description": "Text that may contain {{ path }} bindings, e.g. '{{ business.phone }}' or '{{ business.whatsapp || business.phone }}'."
    },
    "color": {
      "type": "string",
      "description": "#RGB, #RRGGBB, #RRGGBBAA, 'transparent', or a binding such as '{{ brand.colors.primary }}'.",
      "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|transparent|\\{\\{.+\\}\\}.*)$"
    },
    "gradient": {
      "type": "object",
      "required": ["type", "stops"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "linear" },
        "angle": { "type": "number", "description": "Degrees. 0 = left to right, 90 = top to bottom.", "default": 90 },
        "stops": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["offset", "color"],
            "additionalProperties": false,
            "properties": {
              "offset": { "type": "number", "minimum": 0, "maximum": 1 },
              "color": { "$ref": "#/$defs/color" },
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "fill": { "oneOf": [{ "$ref": "#/$defs/color" }, { "$ref": "#/$defs/gradient" }] },
    "box": {
      "type": "object",
      "description": "Bounding box in canvas px (or in the parent group's design space).",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "hAlign": { "enum": ["left", "center", "right"] },
    "vAlign": { "enum": ["top", "middle", "bottom"] },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "blur": { "type": "number", "minimum": 0, "maximum": 100 },
        "dx": { "type": "number" },
        "dy": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string" },
        "fontWeight": { "type": "integer", "enum": [100, 200, 300, 400, 500, 600, 700, 800, 900] },
        "italic": { "type": "boolean" },
        "fontSize": { "type": "number", "minimum": 4, "maximum": 1000, "description": "Maximum font size in px. With fit='shrink' the text shrinks below this to stay inside the box." },
        "color": { "$ref": "#/$defs/color" },
        "align": { "$ref": "#/$defs/hAlign" },
        "verticalAlign": { "$ref": "#/$defs/vAlign" },
        "lineHeight": { "type": "number", "minimum": 0.5, "maximum": 3 },
        "letterSpacing": { "type": "number", "minimum": -20, "maximum": 100, "description": "Extra px between letters." },
        "textTransform": { "enum": ["none", "uppercase", "lowercase", "capitalize"] },
        "shadow": { "$ref": "#/$defs/shadow" }
      }
    },
    "layerBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "box": { "$ref": "#/$defs/box" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "hidden": { "type": "boolean" },
        "locked": { "type": "boolean", "description": "Editor hint: users cannot move or edit this layer." },
        "editable": {
          "type": "array",
          "description": "Editor hint: the properties a user may override for this layer.",
          "items": { "enum": ["text", "src", "box", "style", "hidden", "opacity"] }
        }
      }
    },

    "imageLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }],
      "required": ["box", "src"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "image" },
        "src": { "$ref": "#/$defs/binding", "description": "asset key, https URL, data: URI, or binding." },
        "fit": { "enum": ["cover", "contain", "fill"], "default": "cover" },
        "position": { "type": "string", "enum": ["center", "top", "bottom", "left", "right", "attention", "entropy"], "default": "center" },
        "radius": { "type": "number", "minimum": 0 }
      }
    },
    "shapeLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }],
      "required": ["box", "shape"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "shape" },
        "shape": { "enum": ["rect", "ellipse", "path"] },
        "path": { "type": "string", "description": "SVG path data in a 0..viewBox space (shape='path' only)." },
        "viewBox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "fill": { "$ref": "#/$defs/fill" },
        "radius": { "type": "number", "minimum": 0 },
        "stroke": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "color": { "$ref": "#/$defs/color" }, "width": { "type": "number", "minimum": 0 } }
        }
      }
    },
    "textLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }],
      "required": ["box", "text"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "text" },
        "text": { "$ref": "#/$defs/binding" },
        "style": { "$ref": "#/$defs/textStyle" },
        "fit": { "enum": ["shrink", "fixed"], "default": "shrink" },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 50 },
        "hideIfEmpty": { "type": "boolean", "default": true }
      }
    },
    "logoLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }],
      "required": ["box", "src"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "logo" },
        "src": { "$ref": "#/$defs/binding", "description": "Usually '{{ brand.logo.primary }}' or '{{ brand.logo.light || brand.logo.primary }}'." },
        "align": { "$ref": "#/$defs/hAlign" },
        "verticalAlign": { "$ref": "#/$defs/vAlign" },
        "trim": { "type": "boolean", "default": true, "description": "Remove transparent or flat borders around the uploaded logo before fitting it." },
        "plate": {
          "type": "object",
          "description": "Optional background plate behind the logo, so it stays readable on any artwork.",
          "additionalProperties": false,
          "properties": {
            "fill": { "$ref": "#/$defs/fill" },
            "radius": { "type": "number", "minimum": 0 },
            "padding": { "type": "number", "minimum": 0 }
          }
        },
        "hideIfEmpty": { "type": "boolean", "default": true }
      }
    },
    "badgeLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }],
      "required": ["box", "text"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "badge" },
        "icon": { "enum": ["none", "phone", "whatsapp", "globe", "mail", "location", "instagram", "facebook"] },
        "text": { "$ref": "#/$defs/binding" },
        "width": { "enum": ["auto", "fill"], "default": "auto" },
        "align": { "$ref": "#/$defs/hAlign" },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": { "$ref": "#/$defs/fill" },
            "color": { "$ref": "#/$defs/color" },
            "iconColor": { "$ref": "#/$defs/color" },
            "fontFamily": { "type": "string" },
            "fontWeight": { "type": "integer" },
            "fontSize": { "type": "number", "minimum": 4 },
            "radius": { "type": "number", "minimum": 0 },
            "paddingX": { "type": "number", "minimum": 0 },
            "gap": { "type": "number", "minimum": 0 },
            "border": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "color": { "$ref": "#/$defs/color" }, "width": { "type": "number", "minimum": 0 } }
            }
          }
        },
        "hideIfEmpty": { "type": "boolean", "default": true }
      }
    },
    "qrLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }],
      "required": ["box", "data"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "qr" },
        "data": { "$ref": "#/$defs/binding" },
        "color": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "margin": { "type": "integer", "minimum": 0, "maximum": 10 },
        "hideIfEmpty": { "type": "boolean", "default": true }
      }
    },
    "groupLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }],
      "required": ["box", "designSize", "layers"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "group" },
        "designSize": {
          "type": "object",
          "description": "Coordinate space of the child layers. It is scaled to fit the group's box.",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": { "width": { "type": "number" }, "height": { "type": "number" } }
        },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }
      }
    },
    "frameLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }],
      "required": ["box", "slot"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "frame" },
        "slot": { "enum": ["footer", "header", "full", "side"] },
        "defaultFrameId": { "$ref": "#/$defs/slug" },
        "accepts": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "description": "Optional allow-list of frame ids. Empty means any frame with a matching slot." }
      }
    },

    "layer": {
      "type": "object",
      "required": ["type"],
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        { "$ref": "#/$defs/imageLayer" },
        { "$ref": "#/$defs/shapeLayer" },
        { "$ref": "#/$defs/textLayer" },
        { "$ref": "#/$defs/logoLayer" },
        { "$ref": "#/$defs/badgeLayer" },
        { "$ref": "#/$defs/qrLayer" },
        { "$ref": "#/$defs/groupLayer" },
        { "$ref": "#/$defs/frameLayer" }
      ]
    }
  }
}
