{
  "$schema": "../schemas/template.schema.json",
  "schemaVersion": 1,
  "kind": "template",
  "id": "festival-diwali-square",
  "version": 1,
  "name": "Diwali greeting (1:1)",
  "canvas": { "width": 1080, "height": 1080, "background": "#1c0a00" },
  "meta": {
    "aspectRatio": "1:1",
    "languages": ["hi", "en"],
    "contentStyle": "greeting",
    "categories": ["all"],
    "festivalKeys": ["diwali"],
    "tags": ["diya", "lights"]
  },
  "fonts": ["Noto Sans", "Noto Sans Devanagari"],
  "layers": [
    { "id": "background", "type": "image", "src": "diwali-bg.svg", "box": { "x": 0, "y": 0, "w": 1080, "h": 1080 }, "fit": "cover", "locked": true },
    {
      "id": "corner-logo",
      "type": "logo",
      "src": "{{ brand.logo.light || brand.logo.primary }}",
      "box": { "x": 40, "y": 40, "w": 150, "h": 100 },
      "align": "left",
      "verticalAlign": "top",
      "editable": ["box", "hidden"]
    },
    {
      "id": "greeting",
      "type": "text",
      "text": "{{ event.greeting || 'शुभ दीपावली' }}",
      "box": { "x": 90, "y": 300, "w": 900, "h": 180 },
      "maxLines": 1,
      "style": {
        "fontFamily": "Noto Sans Devanagari",
        "fontWeight": 800,
        "fontSize": 140,
        "color": "#fcd34d",
        "align": "center",
        "shadow": { "color": "#000000", "blur": 8, "dx": 0, "dy": 6, "opacity": 0.7 }
      },
      "editable": ["text", "style"]
    },
    {
      "id": "message",
      "type": "text",
      "text": "{{ event.message || 'May the festival of lights bring joy, prosperity and success to you and your family.' }}",
      "box": { "x": 140, "y": 500, "w": 800, "h": 140 },
      "maxLines": 3,
      "style": { "fontFamily": "Noto Sans", "fontSize": 36, "color": "#fff7ed", "align": "center", "lineHeight": 1.3 },
      "editable": ["text", "style"]
    },
    { "id": "frame", "type": "frame", "slot": "footer", "defaultFrameId": "footer-wave", "box": { "x": 0, "y": 860, "w": 1080, "h": 220 } }
  ]
}
