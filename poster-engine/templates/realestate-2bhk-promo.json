{
  "$schema": "../schemas/template.schema.json",
  "schemaVersion": 1,
  "kind": "template",
  "id": "realestate-2bhk-promo",
  "version": 1,
  "name": "Real estate project launch (4:5)",
  "canvas": { "width": 1080, "height": 1350, "background": "#0f172a" },
  "meta": {
    "aspectRatio": "4:5",
    "languages": ["en"],
    "contentStyle": "promotional",
    "categories": ["real-estate", "real-estate.2bhk", "real-estate.3bhk"],
    "tags": ["launch", "apartments"]
  },
  "fonts": ["Noto Sans"],
  "layers": [
    {
      "id": "photo",
      "type": "image",
      "src": "{{ post.photo || 'property.svg' }}",
      "box": { "x": 0, "y": 0, "w": 1080, "h": 860 },
      "fit": "cover",
      "position": "attention",
      "editable": ["src"]
    },
    {
      "id": "photo-fade",
      "type": "shape",
      "shape": "rect",
      "box": { "x": 0, "y": 560, "w": 1080, "h": 300 },
      "fill": { "type": "linear", "angle": 90, "stops": [{ "offset": 0, "color": "#0f172a", "opacity": 0 }, { "offset": 1, "color": "#0f172a" }] },
      "locked": true
    },
    {
      "id": "label",
      "type": "badge",
      "icon": "none",
      "text": "{{ post.label || 'NEW LAUNCH' }}",
      "box": { "x": 60, "y": 60, "w": 400, "h": 60 },
      "style": { "background": "{{ brand.colors.accent || '#f59e0b' }}", "color": "#111827", "fontFamily": "Noto Sans", "fontWeight": 800, "fontSize": 28, "radius": 8 }
    },
    {
      "id": "headline",
      "type": "text",
      "text": "{{ post.headline || 'Premium 2 & 3 BHK Apartments' }}",
      "box": { "x": 60, "y": 760, "w": 960, "h": 150 },
      "maxLines": 2,
      "style": { "fontFamily": "Noto Sans", "fontWeight": 800, "fontSize": 68, "color": "#ffffff", "lineHeight": 1.1, "verticalAlign": "bottom" },
      "editable": ["text", "style"]
    },
    {
      "id": "features",
      "type": "text",
      "text": "{{ post.features || 'Clubhouse · Gym · 24x7 Security · Covered Parking' }}",
      "box": { "x": 60, "y": 920, "w": 700, "h": 90 },
      "maxLines": 2,
      "style": { "fontFamily": "Noto Sans", "fontSize": 30, "color": "#cbd5e1", "lineHeight": 1.3, "verticalAlign": "top" },
      "editable": ["text"]
    },
    {
      "id": "price",
      "type": "badge",
      "icon": "none",
      "text": "{{ post.price }}",
      "box": { "x": 60, "y": 1030, "w": 700, "h": 70 },
      "style": { "background": "{{ brand.colors.primary || '#1e3a8a' }}", "color": "#ffffff", "fontFamily": "Noto Sans", "fontWeight": 700, "fontSize": 34, "radius": 14 },
      "editable": ["text", "hidden"]
    },
    {
      "id": "qr",
      "type": "qr",
      "data": "{{ post.link || business.website }}",
      "box": { "x": 820, "y": 920, "w": 200, "h": 200 },
      "margin": 2,
      "editable": ["hidden"]
    },
    { "id": "frame", "type": "frame", "slot": "footer", "defaultFrameId": "footer-classic", "box": { "x": 0, "y": 1130, "w": 1080, "h": 220 } }
  ]
}
