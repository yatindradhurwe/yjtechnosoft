# ---------------------------------------------------------------------------
# Creator platform API – copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL 14+ (the btree_gist extension is created by the first migration)
DATABASE_URL=postgresql://creator:change-me@localhost:5432/creator

# Public URLs (no trailing slash). In production both are usually https://app.example.com
APP_URL=http://localhost:5174
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5174
# Root domain for creator subdomains (creator.example.com) and custom-domain CNAME target
PLATFORM_DOMAIN=
BRAND_NAME=YJ Creator Studio

# Secrets – generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
MEDIA_SIGNING_SECRET=dev-media-secret-change-me-please
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts provider credentials in the DB.
# Required in production. Rotating it requires re-saving integrations (see docs/SECURITY.md).
INTEGRATION_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Local file storage (private files are never served directly by Nginx)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200

# First Super Admin (created by `npm run db:seed`; password ≥ 12 characters)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---- Optional providers. Each can also be configured in Admin › Integrations (DB values win). ----
# Razorpay (India) – https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe (international) – https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Email (SMTP – SES, Resend SMTP, Postmark, Zoho…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=YJ Creator Studio <no-reply@example.com>
# Google sign-in – redirect URI: {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI assistant: anthropic | openai | none
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set to 1 when running the background worker as a separate process (npm run worker)
DISABLE_WORKER=
