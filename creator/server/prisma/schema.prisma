model AiCreditLedger {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  delta     Int
  reason    String
  usageId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([tenantId])
}

enum IntegrationKind {
  RAZORPAY
  STRIPE
  SMTP
  RESEND
  WHATSAPP
  ZOOM
  AI
  S3
  MUX
}

/// Provider credentials. Non-secret settings in `config`; secrets AES-256-GCM
/// encrypted in `secretsEnc` with INTEGRATION_ENCRYPTION_KEY. `scopeKey` is the
/// tenant id or "platform".
model ProviderIntegration {
  id          String          @id @default(uuid()) @db.Uuid
  scopeKey    String
  kind        IntegrationKind
  enabled     Boolean         @default(true)
  config      Json            @default("{}")
  secretsEnc  String?
  updatedById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([scopeKey, kind])
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  payload        Json
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lastError      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
}

enum CmsStatus {
  DRAFT
  PUBLISHED
}

/// Marketing-site page. `sections` is validated against the CMS block schema.
model CmsPage {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  title       String
  status      CmsStatus @default(DRAFT)
  sections    Json      @default("[]")
  seo         Json      @default("{}")
  showInNav   Boolean   @default(false)
  navOrder    Int       @default(0)
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Global site settings: navigation, footer, brand, analytics ids
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  body      String
  audience  String    @default("creators")
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Explicit, time-boxed, read-only support access granted by a workspace owner.
/// Platform staff cannot enter a workspace without one (no silent impersonation).
model SupportAccessGrant {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  grantedById String    @db.Uuid
  reason      String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, expiresAt])
}
