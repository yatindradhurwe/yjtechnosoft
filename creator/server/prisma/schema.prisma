  meetingUrl       String?
  meetingId        String?
  recordingAssetId String?         @db.Uuid
  replayEnabled    Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  registrations WorkshopRegistration[]

  @@index([tenantId, startsAt])
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELED
}

model WorkshopRegistration {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  workshopId String             @db.Uuid
  userId     String             @db.Uuid
  status     RegistrationStatus @default(REGISTERED)
  attendedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([workshopId, userId])
}

// ---------------------------------------------------------------------------
// Community
// ---------------------------------------------------------------------------

enum CommunityAccess {
  FREE
  PAID
}

model Community {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  name        String
  slug        String
  description String?
  access      CommunityAccess @default(FREE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  channels Channel[]

  @@unique([tenantId, slug])
}

enum ChannelType {
  FEED
  ANNOUNCEMENT
}

model Channel {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  communityId String      @db.Uuid
  name        String
  type        ChannelType @default(FEED)
  position    Int         @default(0)
  createdAt   DateTime    @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  posts     Post[]
}

enum ContentStatus {
  VISIBLE
  HIDDEN
}

model Post {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  channelId String        @db.Uuid
  authorId  String        @db.Uuid
  title     String?
  body      String
  pinned    Boolean       @default(false)
  status    ContentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]

  @@index([channelId, pinned, createdAt])
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  postId    String        @db.Uuid
  authorId  String        @db.Uuid
  body      String
  status    ContentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  isGroup   Boolean  @default(false)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  conversationId String   @db.Uuid
  senderId       String   @db.Uuid
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model ContentReport {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  reporterId String       @db.Uuid
  entityType String
  entityId   String       @db.Uuid
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([tenantId, status])
}

model UserBlock {
  tenantId  String   @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  @@id([tenantId, blockerId, blockedId])
}

// ---------------------------------------------------------------------------
// Consultations
// ---------------------------------------------------------------------------

model ConsultationOffering {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  hostId      String   @db.Uuid
  productId   String?  @db.Uuid
  title       String
  description String?
  durationMin Int
  bufferMin   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
}

/// Weekly availability: weekday 0=Sunday, minutes from midnight in `timezone`
model AvailabilityRule {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  hostId      String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  timezone    String @default("Asia/Kolkata")

  @@index([tenantId, hostId])
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

/// Overlapping active bookings for a host are rejected by the exclusion
/// constraint `booking_no_overlap` (see migration SQL).
model Booking {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  offeringId String        @db.Uuid
  hostId     String        @db.Uuid
  customerId String        @db.Uuid
  startsAt   DateTime
  endsAt     DateTime
  status     BookingStatus @default(CONFIRMED)
  orderId    String?       @db.Uuid
  meetingUrl String?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  offering ConsultationOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([tenantId, hostId, startsAt])
}

// ---------------------------------------------------------------------------
// CRM & marketing automation
// ---------------------------------------------------------------------------

model Contact {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  userId          String?   @db.Uuid
  email           String
  name            String?
  phone           String?
  source          String?
  customFields    Json      @default("{}")
  consentEmail    Boolean   @default(false)
  consentWhatsapp Boolean   @default(false)
  consentAt       DateTime?
  unsubscribedAt  DateTime?
  lastActivityAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tags ContactTag[]

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
}

model Tag {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name     String

  contacts ContactTag[]

  @@unique([tenantId, name])
}

model ContactTag {
  contactId String @db.Uuid
  tagId     String @db.Uuid

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  channel     MessageChannel
  name        String
  subject     String?
  body        String
  /// Filter: {"tags":["vip"]} – empty = all consenting contacts
  audience    Json           @default("{}")
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId, status])
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model MessageLog {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String?        @db.Uuid
  campaignId        String?        @db.Uuid
  contactId         String?        @db.Uuid
  channel           MessageChannel
  to                String
  subject           String?
  status            DeliveryStatus
  error             String?
  providerMessageId String?
  createdAt         DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([campaignId])
}

model Suppression {
  tenantId  String         @db.Uuid
  channel   MessageChannel
  address   String
  reason    String?
  createdAt DateTime       @default(now())

  @@id([tenantId, channel, address])
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model AutomationWorkflow {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  /// {"event":"order.paid","productId":"..."}
  trigger   Json
  /// [{"type":"delay","minutes":60},{"type":"send_email","subject":"..","body":".."},{"type":"add_tag","tag":"buyer"}]
  steps     Json
  status    WorkflowStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  executions AutomationExecution[]
}

enum ExecutionStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
}

model AutomationExecution {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  workflowId     String          @db.Uuid
  contactId      String          @db.Uuid
  idempotencyKey String          @unique
  status         ExecutionStatus @default(RUNNING)
  stepIndex      Int             @default(0)
  nextRunAt      DateTime?
  attempts       Int             @default(0)
  history        Json            @default("[]")
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
}

// ---------------------------------------------------------------------------
// Affiliates
