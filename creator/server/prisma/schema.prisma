enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Affiliate {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  userId        String          @db.Uuid
  code          String
  status        AffiliateStatus @default(PENDING)
  commissionBps Int             @default(1000)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  clicks      ReferralClick[]
  commissions Commission[]

  @@unique([tenantId, code])
  @@unique([tenantId, userId])
}

model AffiliateProductRule {
  tenantId      String @db.Uuid
  productId     String @db.Uuid
  commissionBps Int

  @@id([tenantId, productId])
}

model ReferralClick {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  affiliateId String   @db.Uuid
  visitorId   String
  landingPath String?
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([tenantId, visitorId, createdAt])
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  REVERSED
}

model Commission {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  affiliateId String           @db.Uuid
  orderId     String           @unique @db.Uuid
  amount      Int
  currency    String
  status      CommissionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

/// Idempotent: sourceKey (e.g. "lesson:<id>") is unique per user per tenant
model PointsLedger {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  points    Int
  reason    String
  sourceKey String
  createdAt DateTime @default(now())

  @@unique([tenantId, userId, sourceKey])
  @@index([tenantId, createdAt])
}

model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  icon        String?
  /// {"type":"points_at_least","value":100} | {"type":"courses_completed","value":1}
  rule        Json?
  createdAt   DateTime @default(now())

  awards Achievement[]
}

model Achievement {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  badgeId   String   @db.Uuid
  userId    String   @db.Uuid
  awardedAt DateTime @default(now())

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([badgeId, userId])
}

model Challenge {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  title       String
  description String?
  points      Int      @default(10)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
}

model Habit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  title     String
  createdAt DateTime @default(now())

  logs HabitLog[]
}

model HabitLog {
  habitId String @db.Uuid
  day     String

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([habitId, day])
}

// ---------------------------------------------------------------------------
// Landing pages, themes, domains
